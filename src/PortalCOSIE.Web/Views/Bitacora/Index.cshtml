@using System.Text
@model IEnumerable<PortalCOSIE.Domain.Entities.EntradaBitacoras.EntradaBitacora>
@{
    ViewData["Title"] = "Bitácora del portal";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 py-1"><i class="fas fa-clipboard-list me-2"></i>@ViewData["Title"]</h6>
    </div>

    <div class="card-body px-4" style="height: calc(100vh - 164px);">

        <table id="tblBitacora" class="table table-hover table-bordered compact w-100">
            <thead class="table-light table-bordered">
                <tr class="small">
                    <th>Id</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>Entidad ID</th>
                    <th>Cambios</th>
                    <th>Usuario</th>
                    <th>IP</th>
                    <th>Navegador</th>
                    <th>Fecha</th>
                </tr>
                <tr class="small filters">
                    @for (int i = 0; i < 9; i++)
                    {
                        <th><input type="text" class="form-control form-control-sm" placeholder="Buscar" /></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var bitacora in Model)
                {
                    var tieneCambios = !string.IsNullOrWhiteSpace(bitacora.ValorNuevo);
                    var cambiosB64 = tieneCambios
                        ? Convert.ToBase64String(Encoding.UTF8.GetBytes(bitacora.ValorNuevo!))
                        : string.Empty;
                    var userAgent = bitacora.UserAgent ?? string.Empty;
                    var userAgentCorto = userAgent.Length > 36 ? userAgent[..36] + "…" : userAgent;

                    <tr class="small">
                        <td class="fw-bold">@bitacora.Id</td>
                        <td>
                            <span class="badge @AccionBadge(bitacora.Accion)">@bitacora.Accion</span>
                        </td>
                        <td>@bitacora.Entidad</td>
                        <td class="text-break">@bitacora.EntidadId</td>
                        <td class="text-center">
                            @if (tieneCambios)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary btn-ver-cambios"
                                        data-cambios="@cambiosB64"
                                        data-entidad="@bitacora.Entidad"
                                        data-accion="@bitacora.Accion">
                                    <i class="fas fa-eye me-1"></i>Ver
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-break">@bitacora.IdentityUserId</td>
                        <td>@bitacora.IpAddress</td>
                        <td title="@userAgent">@userAgentCorto</td>
                        <td>@bitacora.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_ModalDetalle" />

@functions {
    private static string AccionBadge(string accion) => accion switch
    {
        "Crear" => "bg-success",
        "Editar" => "bg-warning text-dark",
        "Eliminar" => "bg-danger",
        _ => "bg-secondary"
    };
}

@section Scripts {
    <script>
        $(document).ready(function () {
            const modal = new bootstrap.Modal('#modalDetalleBitacora');

            const table = $('#tblBitacora').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/2.3.2/i18n/es-MX.json' },
                paging: true,
                scrollY: 'calc(100vh - 430px)',
                orderCellsTop: true,
                order: [],
                autoWidth: false,
                columnDefs: [
                    { targets: 4, orderable: false, searchable: false }
                ]
            });

            $('#tblBitacora thead tr.filters th').each(function (i) {
                $('input', this).on('keyup change', function () {
                    if (table.column(i).search() !== this.value)
                        table.column(i).search(this.value).draw();
                });
            });

            $('#tblBitacora').on('click', '.btn-ver-cambios', function () {
                const btn = $(this);
                const cambios = JSON.parse(atob(btn.data('cambios')));
                const filas = Object.entries(cambios).map(([campo, valor]) => {
                    const texto = valor === null || valor === undefined ? '—' : String(valor);
                    return `<tr>
                        <td class="small ps-3 fw-semibold text-break">${campo}</td>
                        <td class="small text-break">${$('<div>').text(texto).html()}</td>
                    </tr>`;
                }).join('');

                $('#modalDetalleBitacoraLabel').html(
                    `<i class="fas fa-list-ul me-2"></i>${btn.data('accion')} — ${btn.data('entidad')}`);
                $('#auditDetailBody').html(filas || '<tr><td colspan="2" class="text-muted small ps-3">Sin cambios visibles</td></tr>');
                modal.show();
            });
        });
    </script>
}