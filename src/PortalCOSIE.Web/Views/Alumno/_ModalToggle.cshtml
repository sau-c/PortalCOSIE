<div class="modal fade" id="modalToggle" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="toggleRoleForm" asp-action="ActualizarRol" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" id="modalHeader">
                    <h6 class="modal-title">
                        <i id="modalIcon" class="me-2"></i>
                        <span id="modalTitle">Cambiar estado</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center">
                        <div id="modalMessage" class="alert" role="alert"></div>
                    </div>

                    <div class="form-text text-muted mt-2">
                        <i class="fas fa-envelope me-1"></i>Se enviará un correo de aviso al usuario
                    </div>
                    <input type="hidden" id="userId" name="userId" />
                    <input type="hidden" id="rol" name="rol" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="button" id="confirmButton" class="btn">
                        <i id="confirmIcon" class="me-2"></i>
                        <span id="confirmText">Confirmar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("modalToggle");
        const form = document.getElementById("toggleRoleForm");
        const btnConfirmar = document.getElementById("confirmButton");
        const bsModal = bootstrap.Modal.getOrCreateInstance(modal);
        const control = bloqueadorBoton(btnConfirmar);

        modal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            const userId = button.getAttribute("data-user-id");
            const currentRole = button.getAttribute("data-current-role");
            const roleType = button.getAttribute("data-role-type");

            document.getElementById("userId").value = userId;
            document.getElementById("rol").value = roleType;
            control.restaurar();

            const isActive = currentRole !== "Inactivo";

            if (isActive) {
                document.getElementById("modalHeader").className = "modal-header bg-warning text-dark";
                document.getElementById("modalIcon").className = "fas fa-user-slash";
                document.getElementById("modalTitle").textContent = "Desactivar usuario";
                document.getElementById("modalMessage").className = "alert alert-warning";
                document.getElementById("modalMessage").innerHTML =
                    `<strong>¿Desactivar usuario?</strong><br>
                     El usuario perderá el rol de "<strong>${roleType}</strong>" y solo verá el calendario al ingresar.`;
                btnConfirmar.className = "btn btn-warning";
                document.getElementById("confirmIcon").className = "fas fa-user-slash";
                document.getElementById("confirmText").textContent = "Desactivar";
            } else {
                document.getElementById("modalHeader").className = "modal-header bg-success text-white";
                document.getElementById("modalIcon").className = "fas fa-user-check";
                document.getElementById("modalTitle").textContent = "Activar usuario";
                document.getElementById("modalMessage").className = "alert alert-success";
                document.getElementById("modalMessage").innerHTML =
                    `<strong>¿Activar usuario?</strong><br>
                     El usuario obtendrá el rol de "<strong>${roleType}</strong>" y podrá generar su certificado de firma desde Mi cuenta.`;
                btnConfirmar.className = "btn btn-success";
                document.getElementById("confirmIcon").className = "fas fa-user-check";
                document.getElementById("confirmText").textContent = "Activar";
            }
        });

        btnConfirmar.addEventListener("click", async function () {
            control.bloquear();

            try {
                const formData = new FormData(form);
                const data = await executeFetch(form.action, "POST", formData);

                bsModal.hide();
                showGlobalModal("success", data.message);
            } catch (error) {
                showGlobalModal("error", error.message, {
                    onClose: () => control.restaurar()
                });
            }
        });
    });
</script>