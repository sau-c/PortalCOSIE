@using PortalCOSIE.Application.Features.Usuarios.DTO
@model CertificadoFirmaDTO?

@if (Model == null)
{
    <div class="alert alert-warning small mb-3">
        <i class="fas fa-exclamation-triangle me-1"></i>
        No tienes un certificado registrado. Genera uno en <strong>Mi cuenta</strong>@(User.IsInRole("Administrador") ? " (sección Firma institucional)" : "") antes de firmar.
    </div>
}
else if (!Model.EsValidoParaFirma)
{
    <div class="alert alert-danger small mb-3">
        <i class="fas fa-exclamation-triangle me-1"></i>
        El certificado registrado no es válido para firmar. Re-emítelo desde <strong>Mi cuenta</strong>.
        <span class="text-muted d-block mt-1">Registrado: @Model.Sujeto</span>
    </div>
}
else
{
    <div class="alert alert-info small mb-3 py-2">
        <i class="fas fa-certificate me-1"></i>
        <strong>Certificado registrado:</strong> @Model.Sujeto
        <span class="text-muted d-block">Vigente hasta @Model.VigenteHasta.ToString("dd/MM/yyyy")</span>
    </div>
}